{
  "name": "print3d",
  "version": "1.1.0",
  "private": true,
  "description": "npm deployment commands for the Print3D Telegram order service",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "setup": "node scripts/npm.mjs install",
    "start": "node scripts/npm.mjs start",
    "deploy": "node scripts/npm.mjs start",
    "configure": "node scripts/npm.mjs reconfigure",
    "build": "node scripts/npm.mjs build",
    "test": "node --test tests/npm.test.mjs",
    "test:backend": "node scripts/npm.mjs test"
  },
  "repository": { "type": "git", "url": "https://github.com/Zhuan-05/print3.git" }
}
