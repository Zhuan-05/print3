# Copy to .env and replace every REPLACE value. Never commit .env.
BOT_TOKEN=REPLACE_WITH_BOTFATHER_TOKEN
ADMIN_CHAT_ID=-1001234567890
ADMIN_USER_IDS=123456789,987654321
# Generate: python3 -c 'import secrets; print(secrets.token_hex(32))'
WEBHOOK_SECRET=REPLACE_WITH_64_HEX_CHARACTERS
# Editor/form-bound ID from Apps Script describeForm(); NOT public /d/e/ ID.
GOOGLE_FORM_ID=REPLACE_WITH_FORM_EDITOR_ID
GOOGLE_FORM_URL=https://docs.google.com/forms/d/e/REPLACE_WITH_PUBLIC_FORM_ID/viewform
FORM_TELEGRAM_ENTRY=entry.12345678
FORM_BINDING_ENTRY=entry.87654321
DATABASE_PATH=data/orders.sqlite3
PAYMENT_INSTRUCTIONS="请转账至商家指定账户，并备注订单号。正式使用前请在这里填写实际收款说明。"
