[Unit]
Description=3D Print Telegram Order Service
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=print3d
Group=print3d
WorkingDirectory=/opt/print3d
EnvironmentFile=/opt/print3d/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/print3d/.venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-access-log
Restart=always
RestartSec=5
TimeoutStopSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/print3d/data

[Install]
WantedBy=multi-user.target
